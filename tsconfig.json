{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@kivo/trading/*": [
        "./trading/*"
      ],
      "@kivo/shared/*": [
        "./shared/*"
      ],
      "viem": [
        "./node_modules/viem"
      ],
      "viem/*": [
        "./node_modules/viem/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
