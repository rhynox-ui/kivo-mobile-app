{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@kivo/trading/*": ["./trading/*"],
      "@kivo/shared/*": ["./shared/*"],
      "viem": ["./node_modules/viem"],
      "viem/*": ["./node_modules/viem/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "android",
    "trading/core/executeRelayQuote.ts",
    "trading/core/fallbackDex.ts",
    "trading/core/fallbackTxFirewall.ts",
    "trading/core/solanaSpendGuard.ts",
    "trading/core/solanaTxIntent.ts",
    "trading/core/tradeErrors.ts",
    "trading/core/usdcBalances.ts"
  ]
}
